# Catppuccin Macchiato Theme (for fast-syntax-highlighting)
#
# Source this file after loading fast-syntax-highlighting.
# Style names: https://github.com/zdharma-continuum/fast-syntax-highlighting/blob/master/themes/default.ini

## General
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}default]='fg=#cad3f5'
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}unknown-token]='fg=#ee99a0'
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}comment]='fg=#5b6078'
## Commands
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}reserved-word]='fg=#a6da95'
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}subcommand]='fg=#a6da95'
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}alias]='fg=#a6da95'
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}suffix-alias]='fg=#a6da95'
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}global-alias]='fg=#a6da95'
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}builtin]='fg=#a6da95'
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}function]='fg=#a6da95'
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}command]='fg=#a6da95'
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}hashed-command]='fg=#a6da95'
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}precommand]='fg=#a6da95,italic'
## Punctuation
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}commandseparator]='fg=#ed8796'
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}redirection]='fg=#cad3f5'
## Paths
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}path]='fg=#cad3f5,underline'
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}path-to-dir]='fg=#cad3f5,underline'
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}path_pathseparator]='fg=#ed8796,underline'
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}globbing]='fg=#cad3f5'
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}globbing-ext]='fg=#cad3f5'
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}history-expansion]='fg=#c6a0f6'
## Arguments
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}single-hyphen-option]='fg=#f5a97f'
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}double-hyphen-option]='fg=#f5a97f'
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}back-quoted-argument]='fg=#c6a0f6'
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}single-quoted-argument]='fg=#eed49f'
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}double-quoted-argument]='fg=#eed49f'
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}dollar-quoted-argument]='fg=#cad3f5'
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}back-or-dollar-double-quoted-argument]='fg=#ed8796'
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}back-dollar-quoted-argument]='fg=#ed8796'
## Variables
FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}assign]='fg=#cad3f5'
